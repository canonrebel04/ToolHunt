  "examples": [
    {
      "cmd": "nmap -v<1|2|3> <ip_or_hostname>",
      "explanation": "Scan the top 1000 ports of a remote host with various [v]erbosity levels",
      "source": "tldr:nmap"
    },
    {
      "cmd": "sudo nmap -A -iL <path/to/file.txt>",
      "explanation": "Enable OS detection, version detection, script scanning, and traceroute of hosts from a file",
      "source": "tldr:nmap"
    },
    {
      "cmd": "nmap -p <port1,port2,...> <ip_or_host1,ip_or_host2,...>",
      "explanation": "Scan a specific list of [p]orts (use `-p-` for all ports from 1 to 65535)",
      "source": "tldr:nmap"
    },
    {
      "cmd": "nmap -sC -sV -oA <top-1000-ports> <ip_or_host1,ip_or_host2,...>",
      "explanation": "Perform service and version detection of the top 1000 ports using default NSE scripts, writing results (`-oA`) to output files",
      "source": "tldr:nmap"
    },
    {
      "cmd": "nmap --script \"default and safe\" <ip_or_host1,ip_or_host2,...>",
      "explanation": "Scan target(s) carefully using `default and safe` NSE scripts",
      "source": "tldr:nmap"
    },
    {
      "cmd": "nmap --script \"http-*\" <ip_or_host1,ip_or_host2,...> -p 80,443",
      "explanation": "Scan for web servers running on standard [p]orts 80 and 443 using all available `http-*` NSE scripts",
      "source": "tldr:nmap"
    }
