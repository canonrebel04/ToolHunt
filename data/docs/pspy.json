{
  "id": "pspy",
  "name": "pspy",
  "schema_version": 1,
  "summary": "Monitor linux processes without root permissions.",
  "highlights": [
    "-c — color the printed events (default true)",
    "--debug — print detailed error messages",
    "-d — watch these dirs",
    "-f — print file system events to stdout",
    "-i — scan every 'interval' milliseconds for new processes (default 100)",
    "--ppid — record process ppids",
    "-p — print new processes to stdout (default true)",
    "-r — watch these dirs recursively (default [/usr,/tmp,/etc,/home,/var,/opt])"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install pspy"
    }
  ],
  "usage": "pspy [flags]",
  "subcommands": [],
