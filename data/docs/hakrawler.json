{
  "id": "hakrawler",
  "name": "hakrawler",
  "schema_version": 1,
  "summary": "Simple, fast web crawler designed for easy, quick discovery of endpoints and assets within a web application.",
  "highlights": [
    "-d — Depth to crawl. (default 2)",
    "-insecure — Disable TLS verification.",
    "-json — Output as JSON.",
    "-proxy — Proxy URL. E.g. -proxy http://127.0.0.1:8080",
    "-s — Show the source of URL based on where it was found. E.g. href, form, script, etc.",
    "-size — Page size limit, in KB. (default -1)",
    "-subs — Include subdomains for crawling.",
    "-t — Number of threads to utilise. (default 8)"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install hakrawler"
    }
  ],
  "usage": "of hakrawler:",
