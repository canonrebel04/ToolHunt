{
  "id": "bopscrk",
  "name": "bopscrk",
  "schema_version": 1,
  "summary": "Tool to generate smart wordlists, eg. based on lyrics.",
  "highlights": [
    "-i — interactive mode, the script will ask you about target",
    "-w — words to combine comma-separated (will be combined with all words)",
    "-m — min length for the words to generate (default: 4)",
    "-M — max length for the words to generate (default: 12)",
    "-c — enable case transformations",
    "-l — enable leet transformations",
    "-n — max amount of words to combine each time (default: 2)",
    "-a — artists to search song lyrics (comma-separated)"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install bopscrk"
    }
  ],
  "usage": "bopscrk [-h] [-i] [-w ] [-m ] [-M ] [-c] [-l] [-n ] [-a ] [-o ] [-C ]",
  "subcommands": [],
