      "cmd": "htop --delay <50>",
      "explanation": "Start `htop` with the specified delay between updates, in tenths of a second (i.e. 50 = 5 seconds)",
      "source": "tldr:htop"
    },
    {
      "cmd": "htop --readonly",
      "explanation": "Disable all system and process changing features",
      "source": "tldr:htop"
    },
    {
      "cmd": "<<F1>|<?>>",
      "explanation": "See interactive commands while running `htop`",
