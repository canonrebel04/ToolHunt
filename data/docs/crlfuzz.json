{
  "id": "crlfuzz",
  "name": "crlfuzz",
  "schema_version": 1,
  "summary": "A fast tool to scan CRLF vulnerability written in Go.",
  "highlights": [
    "-u — Define single URL to fuzz",
    "-l — Fuzz URLs within file",
    "-X — Specify request method to use (default: GET)",
    "-o — File to save results",
    "-d — Define request data",
    "-H — Pass custom header to target",
    "-x — Use proxy to fuzz",
    "-c — Set the concurrency level (default: 20)"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install crlfuzz"
    }
  ],
  "usage": "[buffers] | crlfuzz [options]",
  "subcommands": [],
  "flags": [
