{
  "id": "statsprocessor",
  "name": "statsprocessor",
  "schema_version": 1,
  "summary": "A high-performance word-generator based on per-position Markov-attack.",
  "highlights": [
    "--pw-min — Start incrementing at NUM",
    "--pw-max — Stop incrementing at NUM",
    "--markov-disable — Emulates maskprocessor output",
    "--markov-classic — No per-position tables",
    "--threshold — Filter out chars after NUM chars added Set to 0 to disable",
    "--combinations — Calculate number of combinations",
    "--hex-charset — Assume charset is given in hex",
    "-s — skip number of words (for restore)"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install statsprocessor"
    }
  ],
  "usage": "sp32 [options]... hcstat-file [filter-mask]",
