{
  "id": "pdfid",
  "name": "pdfid",
  "schema_version": 1,
  "summary": "Scan a file to look for certain PDF keywords.",
  "highlights": [
    "-s — scan the given directory",
    "-a — display all the names",
    "-e — display extra data, like dates",
    "-f — force the scan of the file, even without proper %PDF header",
    "-d — disable JavaScript and auto launch",
    "-p — plugins to load (separate plugins with a comma , ; @file supported)",
    "-c — output csv data when using plugins",
    "-m — minimum score for plugin results output"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install pdfid"
    }
  ],
  "usage": "pdfid [options] [pdf-file|zip-file|url|@file] ...",
  "subcommands": [],
