{
  "id": "goldeneye",
  "name": "goldeneye",
  "schema_version": 1,
  "summary": "A HTTP DoS test tool. Attack Vector exploited: HTTP Keep Alive + NoCache.",
  "highlights": [
    "-u — File with user-agents to use (default: randomly generated)",
    "-w — Number of concurrent workers (default: 10)",
    "-s — Number of concurrent sockets (default: 500)",
    "-m — HTTP Method to use 'get' or 'post' or 'random' (default: get)",
    "-n — Do not verify SSL Certificate (default: True)",
    "-d — Enable Debug Mode [more verbose output] (default: False)"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install goldeneye"
    }
  ],
  "usage": "goldeneye <url> [OPTIONS]",
