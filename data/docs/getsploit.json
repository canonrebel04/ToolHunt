{
  "id": "getsploit",
  "name": "getsploit",
  "schema_version": 1,
  "summary": "Command line utility for searching and downloading exploits.",
  "highlights": [
    "-j — Show result in JSON format",
    "-m — Mirror (aka copies) exploits to the current working directory",
    "-l — Perform search in the local database instead of searching online",
    "-u — Update getsploit.db database",
    "-s — Set vulners API key",
    "-k — Vulners API key"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install getsploit"
    }
  ],
