{
  "id": "pipal",
  "name": "pipal",
  "schema_version": 1,
  "summary": "A password analyser.",
  "highlights": [
    "-t — show the top X results (default 10)",
    "-o — output to file",
    "--gkey — to allow zip code lookups (optional)",
    "--list-checkers — Show the available checkers and which are enabled",
    "-v — Verbose"
  ],
