{
  "id": "bulk-extractor",
  "name": "bulk-extractor",
  "schema_version": 1,
  "summary": "Bulk Email and URL extraction tool.",
  "highlights": [
    "-D — help on debugging",
    "-J — read and process data in the primary thread",
    "--notify_main_thread — Display notifications in the main thread after phase1 completes. Useful for running with T",
    "--notify_async — Display notificaitons asynchronously (default)",
    "-q — no status or performance output",
    "-R — treat image file as a directory to recursively explore",
    "-Z — wipe the output directory (recursively) before starting",
    "-0 — disable real-time notification"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install bulk-extractor"
    }
  ],
  "usage": "bulk_extractor [OPTION...] image_name",
  "subcommands": [],
