{
  "id": "plecost",
  "name": "plecost",
  "schema_version": 1,
  "summary": "Wordpress finger printer Tool.",
  "highlights": [
    "-v — verbosity level: -v, -vv, -vvv.",
    "-o — report file with extension: xml|json",
    "--hostname — set custom hostname for the HTTP request",
    "-np — do not try to find plugins versions",
    "-nc — do not check Wordpress connectivity",
    "-nv — do not check Wordpress version",
    "-f — force to scan even although not wordpress installation detected",
    "-j — jackass mode: unlimited connections to remote host"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install plecost"
    }
  ],
  "usage": "plecost [-h] [-v] [-o OUTPUT_FILE] [--hostname HOSTNAME] [-np] [-nc]",
  "subcommands": [],
