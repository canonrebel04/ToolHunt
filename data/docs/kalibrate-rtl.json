{
  "id": "kalibrate-rtl",
  "name": "kalibrate-rtl",
  "schema_version": 1,
  "summary": "Fork of http://thre.at/kalibrate/ for use with rtl-sdr devices.",
  "highlights": [
    "-s — band to scan (GSM850, GSM-R, GSM900, EGSM, DCS, PCS)",
    "-f — frequency of nearby GSM base station",
    "-c — channel of nearby GSM base station",
    "-b — band indicator (GSM850, GSM-R, GSM900, EGSM, DCS, PCS)",
    "-g — gain in dB",
    "-d — rtl-sdr device index",
    "-e — initial frequency error in ppm",
    "-E — manual frequency offset in hz"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install kalibrate-rtl"
    }
  ],
