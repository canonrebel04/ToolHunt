{
  "id": "altdns",
  "name": "altdns",
  "schema_version": 1,
  "summary": "Generates permutations, alterations and mutations of subdomains and then resolves them.",
  "highlights": [
    "-i — List of subdomains input",
    "-o — Output location for altered subdomains",
    "-w — List of words to alter the subdomains with",
    "-r — Resolve all altered subdomains",
    "-n — Add number suffix to every domain (0-9)",
    "-e — Ignore existing domains in file",
    "-d — IP address of resolver to use (overrides system default)",
    "-s — File to save resolved altered subdomains to"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install altdns"
    }
  ],
  "usage": "altdns [-h] -i INPUT -o OUTPUT [-w WORDLIST] [-r] [-n] [-e]",
