{
  "id": "winexe",
  "name": "winexe",
  "schema_version": 1,
  "summary": "Remotely execute commands on Windows NT/2000/XP/2003 systems.",
  "highlights": [
    "-A — Get the credentials from a file",
    "-N — Do not ask for a password",
    "-k — Use Kerberos, -k [yes|no]",
    "-d — Set debug level",
    "--uninstall — Uninstall winexe service after remote execution",
    "--reinstall — Reinstall winexe service before remote execution",
    "--system — Use SYSTEM account",
    "--profile — Load user profile"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install winexe"
    }
  ],
  "usage": "winexe [OPTION]... //HOST COMMAND",
