{
  "id": "brutespray",
  "name": "brutespray",
  "schema_version": 1,
  "summary": "Brute-Forcing from Nmap output - Automatically attempts default creds on found services.",
  "highlights": [
    "-C — Specify a combo wordlist deiminated by ':', example: user1:password",
    "-P — Print found hosts parsed from provided host and file arguments",
    "-S — List all supported services",
    "-T — Number of hosts to bruteforce at the same time (default 5)",
    "-f — File to parse; Supported: Nmap, Nessus, Nexpose, Lists, etc",
    "-o — Directory containing successful attempts (default \"brutespray-output\")",
    "-p — Password or password file to use for bruteforce",
    "-q — Suppress the banner"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install brutespray"
    }
  ],
