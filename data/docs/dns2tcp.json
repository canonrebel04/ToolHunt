{
  "id": "dns2tcp",
  "name": "dns2tcp",
  "schema_version": 1,
  "summary": "A tool for relaying TCP connections over DNS.",
  "highlights": [
    "-c — : enable compression",
    "-z — : domain to use (mandatory)",
    "-d — : debug_level (1, 2 or 3)",
    "-r — : resource to access",
    "-k — : pre-shared key",
    "-f — : configuration file",
    "-l — : local port to bind, '-' is for stdin (mandatory if resource defined without program )",
    "-e — : program to execute"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install dns2tcp"
    }
  ],
  "usage": "dns2tcpc [options] [server]",
  "subcommands": [],
