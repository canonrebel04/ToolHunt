{
  "id": "hekatomb",
  "name": "hekatomb",
  "schema_version": 1,
  "summary": "Extract and decrypt all credentials from all domain computers using DPAPI.",
  "highlights": [
    "-pvk — Domain backup keys file",
    "-dns — DNS server IP address to resolve computers hostname",
    "-port — Port to connect to SMB Server",
    "-smb2 — Force the use of SMBv2 protocol",
    "-just-user — Test only specified username",
    "-just-computer — Test only specified computer",
    "-md5 — Print md5 hash instead of clear passwords",
    "-csv — Export results to CSV file"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install hekatomb"
    }
  ],
  "usage": "hekatomb [-h] [-hashes LMHASH:NTHASH] [-pvk PVK] [-dns DNS]",
