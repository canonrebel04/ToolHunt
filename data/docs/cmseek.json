{
  "id": "cmseek",
  "name": "cmseek",
  "schema_version": 1,
  "summary": "CMS (Content Management Systems) Detection and Exploitation suite.",
  "highlights": [
    "-u — Target Url",
    "-l — Path of the file containing list of sites for multi-site scan (comma separated)",
    "--skip-scanned — Skips target if it's CMS was previously detected.",
    "--light-scan — Skips Deep Scan. Does CMS and version detection only.",
    "-o — Only detect CMS, ignore deep scan and version detection.",
    "--follow-redirect — Follows all/any redirect(s)",
    "--no-redirect — Skips all redirects and tests the input target(s)",
    "-r — Use a random user agent"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install cmseek"
    }
  ],
  "usage": "python3 cmseek.py (for guided scanning) OR",
