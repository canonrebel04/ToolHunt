{
  "id": "steghide",
  "name": "steghide",
  "schema_version": 1,
  "summary": "Embeds a message in a file by replacing some of the least significant bits.",
  "highlights": [
    "-ef — select file to be embedded",
    "-ef — embed the file <filename>",
    "-cf — select cover-file",
    "-cf — embed into the file <filename>",
    "-p — specify passphrase",
    "-p — use <passphrase> to embed data",
    "-sf — select stego file",
    "-sf — write result to <filename> instead of cover-file"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install steghide"
    },
    {
      "method": "apt",
      "cmd": "sudo apt install steghide-doc"
    }
  ],
  "usage": "",
