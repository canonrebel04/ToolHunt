      "cmd": "exrex --max-number <100> '<regex>'",
      "explanation": "Generate at most 100 strings that match a `regex`",
      "source": "tldr:exrex"
    },
    {
      "cmd": "exrex --delimiter \"<,>\" '<regex>'",
      "explanation": "Generate all possible strings that match a `regex`, joined by a custom delimiter string",
      "source": "tldr:exrex"
    },
    {
      "cmd": "exrex --count '<regex>'",
