      "source": "tldr:exrex"
    },
    {
      "cmd": "exrex --simplify '<ab|ac>'",
      "explanation": "Simplify a `regex`",
      "source": "tldr:exrex"
    },
    {
      "cmd": "exrex '<[oO0](_)[oO0]>'",
      "explanation": "Print eyes",
      "source": "tldr:exrex"
    },
    {
      "cmd": "exrex '<( {20}(\\| *\\\\|-{22}|\\|)|\\.={50}| ( ){0,5}\\\\\\.| {12}~{39})>'",
