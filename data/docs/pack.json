{
  "id": "pack",
  "name": "pack",
  "schema_version": 1,
  "summary": "Password Analysis and Cracking Kit",
  "highlights": [
    "-r — repack or normalize a jar, suitable for signing with jarsigner",
    "-g — output a plain pack file, suitable to be compressed with a file compression utility",
    "--gzip — (default) post compress the pack output with gzip",
    "-G — remove debugging attributes (SourceFile, LineNumberTable, LocalVariableTable and LocalVari",
    "-O — do not transmit file ordering information",
    "--keep-file-order — (default) preserve input file ordering",
    "-S — limit segment sizes (default unlimited)",
    "-E — packing effort (default N=5)"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install pack"
    }
  ],
  "usage": "pack200 [-opt... | --option=value]... x.pack[.gz] y.jar",
