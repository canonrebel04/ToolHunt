{
  "id": "xsser",
  "name": "xsser",
  "schema_version": 1,
  "summary": "A penetration testing tool for detecting and exploiting XSS vulnerabilites.",
  "highlights": [
    "-s — show advanced statistics output results",
    "-v — active verbose mode output results",
    "--gtk — launch XSSer GTK Interface",
    "--wizard — start Wizard Helper!",
    "--imx — IMX - Create an image with XSS (--imx image.png)",
    "--fla — FLA - Create a flash movie with XSS (--fla movie.swf)",
    "--xst — XST - Cross Site Tracing (--xst http(s)://host.com)",
    "--all — Automatically audit an entire target"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install xsser"
    }
  ],
