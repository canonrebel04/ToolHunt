{
  "id": "gospider",
  "name": "gospider",
  "schema_version": 1,
  "summary": "Fast web spider written in Go.",
  "highlights": [
    "-s — Site to crawl",
    "-S — Site list to crawl",
    "-p — Proxy (Ex: http://127.0.0.1:8080)",
    "-o — Output folder",
    "-u — User Agent to use web: random web user-agent mobi: random mobile user-agent or you can set",
    "--cookie — Cookie to use (testA=a; testB=b)",
    "-H — Header to use (Use multiple flag to set multiple header)",
    "--burp — Load headers and cookie from burp raw http request"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install gospider"
    }
  ],
  "usage": "gospider [flags]",
  "subcommands": [],
  "flags": [
    {
      "name": "--site",
      "short": "-s",
      "aliases": [],
      "arg": "string",
      "required": false,
      "description": "Site to crawl",
      "default": "",
      "example": "gospider --site <string>"
    },
    {
      "name": "--sites",
      "short": "-S",
      "aliases": [],
      "arg": "string",
      "required": false,
      "description": "Site list to crawl",
      "default": "",
      "example": "gospider --sites <string>"
    },
