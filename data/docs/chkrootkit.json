{
  "id": "chkrootkit",
  "name": "chkrootkit",
  "schema_version": 1,
  "summary": "Checks for rootkits on a system.",
  "highlights": [
    "-l — show available tests and exit",
    "-d — debug",
    "-q — quiet mode",
    "-x — expert mode",
    "-s — filter results of sniffer test through 'grep -Ev REGEXP' to exclude expected PACKET_SNIFFE",
    "-r — use DIR as the root directory",
    "-n — skip NFS mount points",
    "-T — skip mount points of the specified file system type"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install chkrootkit"
    }
  ],
  "usage": "/usr/sbin/chkrootkit [options] [test ...]",
