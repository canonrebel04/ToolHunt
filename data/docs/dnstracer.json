{
  "id": "dnstracer",
  "name": "dnstracer",
  "schema_version": 1,
  "summary": "Determines where a given DNS server gets its information from, and follows the chain of DNS servers",
  "highlights": [
    "-c — disable local caching, default enabled",
    "-C — enable negative caching, default disabled",
    "-e — disable EDNS0, default enabled",
    "-E — set EDNS0 size, default 1500",
    "-o — enable overview of received answers, default disabled",
    "-q — query-type to use for the DNS requests, default A",
    "-r — amount of retries for DNS requests, default 3",
    "-s — use this server for the initial request, default localhost If . is specified, A.ROOT-SERVE"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install dnstracer"
    }
  ],
  "usage": "dnstracer [options] [host]",
  "subcommands": [],
  "flags": [
    {
      "name": "-c",
      "short": "",
      "aliases": [],
      "arg": "",
      "required": false,
      "description": "disable local caching, default enabled",
      "default": "",
      "example": "dnstracer -c"
    },
    {
      "name": "-C",
      "short": "",
      "aliases": [],
      "arg": "",
      "required": false,
      "description": "enable negative caching, default disabled",
      "default": "",
