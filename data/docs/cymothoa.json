{
  "id": "cymothoa",
  "name": "cymothoa",
  "schema_version": 1,
  "summary": "A stealth backdooring tool, that inject backdoor's shellcode into an existing process.",
  "highlights": [
    "-p — process pid",
    "-s — shellcode number",
    "-l — memory region name for shellcode injection (default /lib/ld) search for \"r-xp\" permissions",
    "-m — memory region name for persistent memory (default /lib/ld) search for \"rw-p\" permissions, ",
    "-S — list available shellcodes",
    "-f — fork parent process",
    "-F — don't fork parent process",
    "-b — create payload thread (probably you need also -F)"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install cymothoa"
    }
  ],
  "usage": "cymothoa -p <pid> -s <shellcode_number> [options]",
