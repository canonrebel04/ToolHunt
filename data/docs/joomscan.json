{
  "id": "joomscan",
  "name": "joomscan",
  "schema_version": 1,
  "summary": "Detects file inclusion, sql injection, command execution vulnerabilities of a target Joomla! web site.",
  "highlights": [
    "-u — | The Joomla URL/domain to scan.",
    "-ec — | Try to enumerate components.",
    "--cookie — | Set cookie.",
    "-a — | Use the specified User-Agent.",
    "-r — | Use a random User-Agent.",
    "--timeout — | Set timeout.",
    "--proxy — | Use a proxy to connect to the target URL Proxy example: --proxy http://127.0.0.1:8080 ht",
    "--about — | About Author"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install joomscan"
    }
  ],
