{
  "id": "protos-sip",
  "name": "protos-sip",
  "schema_version": 1,
  "summary": "SIP test suite.",
  "highlights": [
    "-touri — <addr> Recipient of the request Example: <addr> : you@there.com",
    "-fromuri — Initiator of the request Default: user@kali",
    "-sendto — Send packets to <domain> instead of domainname of -touri",
    "-callid — Call id to start test-case call ids from Default: 0",
    "-dport — Portnumber to send packets on host. Default: 5060",
    "-lport — Local portnumber to send packets from Default: 5060",
    "-delay — Time to wait before sending new test-case Defaults to 100 ms (milliseconds)",
    "-replywait — Maximum time to wait for host to reply Defaults to 100 ms (milliseconds)"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install protos-sip"
    }
  ],
  "usage": "java -jar <jarfile>.jar [ [OPTIONS] | -touri <SIP-URI> ]",
