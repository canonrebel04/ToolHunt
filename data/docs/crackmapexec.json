{
  "id": "crackmapexec",
  "name": "crackmapexec",
  "schema_version": 1,
  "summary": "A swiss army knife for pentesting Windows/Active Directory environments.",
  "highlights": [
    "-t — set how many concurrent threads to use (default: 100)",
    "--timeout — max timeout in seconds of each thread (default: None)",
    "--jitter — sets a random delay between each connection (default: None)",
    "--darrell — give Darrell a hand",
    "--verbose — enable verbose output"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install crackmapexec"
    }
  ],
