{
  "id": "spooftooph",
  "name": "spooftooph",
  "schema_version": 1,
  "summary": "Designed to automate spoofing or cloning Bluetooth device Name, Class, and Address. Cloning this information effectively allows Bluetooth device to hide in plain sight.",
  "highlights": [
    "-a — : Specify new BD_ADDR",
    "-b — : Number of Bluetooth profiles to display per page",
    "-B — : Disable banner for smaller screens (like phones)",
    "-c — : Specify new CLASS",
    "-i — : Specify interface",
    "-m — : Specify multiple interfaces during selection",
    "-n — : Specify new NAME",
    "-r — : Read in CSV logfile"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install spooftooph"
    }
  ],
