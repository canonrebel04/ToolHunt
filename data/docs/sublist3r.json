{
  "id": "sublist3r",
  "name": "sublist3r",
  "schema_version": 1,
  "summary": "A Fast subdomains enumeration tool for penetration testers.",
  "highlights": [
    "-d — Domain name to enumerate it's subdomains",
    "-b — Enable the subbrute bruteforce module",
    "-p — Scan the found subdomains against specified tcp ports",
    "-v — Enable Verbosity and display results in realtime",
    "-t — Number of threads to use for subbrute bruteforce",
    "-e — Specify a comma-separated list of search engines",
    "-o — Save the results to text file",
    "-n — Output without color"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install sublist3r"
    }
  ],
  "usage": "sublist3r [-h] -d DOMAIN [-b [BRUTEFORCE]] [-p PORTS] [-v [VERBOSE]]",
  "subcommands": [],
  "flags": [
    {
      "name": "--help",
      "short": "-h",
      "aliases": [],
      "arg": "",
      "required": false,
      "description": "show this help message and exit",
      "default": "",
      "example": "sublist3r --help"
    },
    {
      "name": "--domain",
      "short": "-d",
      "aliases": [],
      "arg": "DOMAIN",
      "required": false,
      "description": "Domain name to enumerate it's subdomains",
      "default": "",
