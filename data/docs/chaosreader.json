{
  "id": "chaosreader",
  "name": "chaosreader",
  "schema_version": 1,
  "summary": "A freeware tool to trace tcp, udp etc. sessions and fetch application data from snoop or tcpdump logs.",
  "highlights": [
    "-a — # Create application session files (default)",
    "-d — # Show DNS names instead of IP addresses",
    "-e — # Create HTML 2-way & hex files for everything",
    "--help2 — # Print massive help",
    "-i — # Create info file",
    "-q — # Quiet, no output to screen",
    "-r — # Create raw files",
    "-v — # Verbose - Create ALL files .. (except -e)"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install chaosreader"
    }
  ],
  "usage": "chaosreader [-adehiknqrvxAHIRTUXY] [-D dir]",
  "subcommands": [],
