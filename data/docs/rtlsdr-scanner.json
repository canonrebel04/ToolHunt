{
  "id": "rtlsdr-scanner",
  "name": "rtlsdr-scanner",
  "schema_version": 1,
  "summary": "A cross platform Python frequency scanning GUI for the OsmoSDR rtl-sdr library.",
  "highlights": [
    "-s — Start frequency (MHz)",
    "-e — End frequency (MHz)",
    "-w — Number of sweeps",
    "-p — Delay between sweeps (s)",
    "-g — Gain (dB)",
    "-d — Dwell time (seconds)",
    "-f — FFT bins",
    "-l — Local oscillator offset"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install rtlsdr-scanner"
    }
  ],
  "usage": "rtlsdr_scan.py [-h] [-s START] [-e END] [-w SWEEPS] [-p DELAY]",
  "subcommands": [],
  "flags": [
