{
  "id": "eapmd5pass",
  "name": "eapmd5pass",
  "schema_version": 1,
  "summary": "An implementation of an offline dictionary attack against the EAP-MD5 protocol.",
  "highlights": [
    "-i — interface name",
    "-b — BSSID of target network (default: all)",
    "-C — EAP-MD5 challenge value.",
    "-E — EAP-MD5 response EAP ID value."
