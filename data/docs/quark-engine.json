{
  "id": "quark-engine",
  "name": "quark-engine",
  "schema_version": 1,
  "summary": "An Obfuscation-Neglect Android Malware Scoring System.",
  "highlights": [
    "-s — Show summary report. Optionally specify the name of a rule/label",
    "-d — Show detail report. Optionally specify the name of a rule/label",
    "-o — Output report in JSON",
    "-w — Generate web report",
    "-a — APK file [required]",
    "-r — Rules directory [default: /root/.quark- engine/quark-rules/rules]",
    "-g — Create call graph to call_graph_image directory",
    "-c — Show rules classification"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install quark-engine"
    }
  ],
  "usage": "quark [OPTIONS]",
  "subcommands": [],
  "flags": [
    {
      "name": "--summary",
      "short": "-s",
      "aliases": [],
      "arg": "TEXT",
      "required": false,
      "description": "Show summary report. Optionally specify the name of a rule/label",
      "default": "",
      "example": "quark --summary <text>"
    },
    {
      "name": "--detail",
      "short": "-d",
      "aliases": [],
      "arg": "TEXT",
      "required": false,
      "description": "Show detail report. Optionally specify the name of a rule/label",
      "default": "",
      "example": "quark --detail <text>"
    },
    {
      "name": "--output",
      "short": "-o",
      "aliases": [],
      "arg": "FILE",
      "required": false,
      "description": "Output report in JSON",
      "default": "",
      "example": "quark --output <file>"
    },
    {
      "name": "--webreport",
      "short": "-w",
      "aliases": [],
      "arg": "FILE",
      "required": false,
      "description": "Generate web report",
      "default": "",
      "example": "quark --webreport <file>"
    },
    {
      "name": "--apk",
      "short": "-a",
      "aliases": [],
      "arg": "FILE",
      "required": true,
      "description": "APK file [required]",
      "default": "",
      "example": "quark --apk <file>"
    },
    {
      "name": "--rule",
      "short": "-r",
      "aliases": [],
      "arg": "PATH",
      "required": false,
      "description": "Rules directory [default: /root/.quark- engine/quark-rules/rules]",
      "default": "/root/.quark- engine/quark-rules/rules",
      "example": "quark --rule <path>"
    },
    {
      "name": "--graph",
      "short": "-g",
      "aliases": [],
      "arg": "[png|json]",
      "required": false,
      "description": "Create call graph to call_graph_image directory",
      "default": "",
      "example": "quark --graph <png|json>"
    },
    {
      "name": "--classification",
      "short": "-c",
      "aliases": [],
      "arg": "",
      "required": false,
      "description": "Show rules classification",
      "default": "",
      "example": "quark --classification"
    },
    {
      "name": "--threshold",
      "short": "-t",
      "aliases": [],
      "arg": "[100|80|60|40|20]",
      "required": false,
      "description": "Set the lower limit of the confidence threshold",
      "default": "",
      "example": "quark --threshold <100|80|60|40|20>"
    },
    {
      "name": "--list",
      "short": "-i",
      "aliases": [],
      "arg": "[all|native|custom]",
      "required": false,
      "description": "List classes, methods and descriptors",
      "default": "",
      "example": "quark --list <all|native|custom>"
    },
    {
      "name": "--permission",
      "short": "-p",
      "aliases": [],
      "arg": "",
      "required": false,
      "description": "List Android permissions",
      "default": "",
      "example": "quark --permission"
    },
    {
      "name": "--label",
      "short": "-l",
      "aliases": [],
      "arg": "[max|detailed]",
      "required": false,
      "description": "Show report based on label of rules",
      "default": "",
      "example": "quark --label <max|detailed>"
    },
    {
      "name": "--comparison",
      "short": "-C",
      "aliases": [],
      "arg": "",
      "required": false,
      "description": "Behaviors comparison based on max confidence of rule labels",
      "default": "",
