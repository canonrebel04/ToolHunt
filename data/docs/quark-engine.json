    },
    {
      "name": "--generate-rule",
      "short": "",
      "aliases": [],
      "arg": "DIRECTORY",
      "required": false,
      "description": "Generate rules and output to given directory",
      "default": "",
      "example": "quark --generate-rule <directory>"
    },
    {
      "name": "--core-library",
      "short": "",
      "aliases": [],
      "arg": "[androguard|rizin|radare2|shuriken]",
      "required": false,
      "description": "Specify the core library used to analyze an APK",
      "default": "",
      "example": "quark --core-library <androguard|rizin|radare2|shuriken>"
    },
    {
      "name": "--auto-fix-checksum",
      "short": "",
      "aliases": [],
      "arg": "",
      "required": false,
      "description": "Automatically repair damaged DEX checksum/signature before analyzing (androguard only).When not provided, Quark will prompt in interactive TTY and skip in non-interactive runs.",
      "default": "",
      "example": "quark --auto-fix-checksum"
