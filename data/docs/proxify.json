{
  "id": "proxify",
  "name": "proxify",
  "schema_version": 1,
  "summary": "Swiss Army knife Proxy tool for HTTP/HTTPS traffic capture, manipulation, and replay on the go.",
  "highlights": [
    "-o — Output Directory to store HTTP proxy logs (default \"logs\")",
    "-dump-req — Dump only HTTP requests to output file",
    "-dump-resp — Dump only HTTP responses to output file",
    "-request-dsl — Request Filter DSL",
    "-response-dsl — Response Filter DSL",
    "-request-match-replace-dsl — Request Match-Replace DSL",
    "-response-match-replace-dsl — Response Match-Replace DSL",
    "-http-addr — Listening HTTP IP and Port address (ip:port) (default \"127.0.0.1:8888\")"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install proxify"
    }
  ],
  "usage": "proxify [flags]",
