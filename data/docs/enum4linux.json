{
  "id": "enum4linux",
  "name": "enum4linux",
  "schema_version": 1,
  "summary": "A tool for enumerating information from Windows and Samba systems.",
  "highlights": [
    "-U — get userlist",
    "-M — get machine list*",
    "-S — get sharelist",
    "-P — get password policy information",
    "-G — get group and member list",
    "-d — be detailed, applies to -U and -S",
    "-a — Do all simple enumeration (-U -S -G -P -r -o -n -i). This option is enabled if you don't p",
    "-r — enumerate users via RID cycling"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install enum4linux"
    }
  ],
  "usage": "./enum4linux.pl [options] ip",
