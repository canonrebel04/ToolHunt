{
  "id": "de4dot",
  "name": "de4dot",
  "schema_version": 1,
  "summary": ".NET deobfuscator and unpacker.",
  "highlights": [
    "-r — Scan for .NET files in all subdirs",
    "-ro — Output base dir for recursively found files",
    "-ru — Skip recursively found files with unsupported obfuscator",
    "-d — Detect obfuscators and exit",
    "--asm-path — Add an assembly search path",
    "--dont-rename — Don't rename classes, methods, etc.",
    "--keep-names — Don't rename n(amespaces), t(ypes), p(rops), e(vents), f(ields), m(ethods), a(rgs), g(ener",
    "--dont-create-params — Don't create method params when renaming"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install de4dot"
    }
  ],
  "usage": "",
  "subcommands": [],
