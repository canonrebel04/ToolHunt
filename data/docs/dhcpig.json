{
  "id": "dhcpig",
  "name": "dhcpig",
  "schema_version": 1,
  "summary": "Enhanced DHCPv4 and DHCPv6 exhaustion and fuzzing script written in python using scapy network library.",
  "highlights": [
    "-v — ... 0 ... no (3) 1 ... minimal 10 ... default 99 ... debug",
    "-6 — ... DHCPv6 (off, DHCPv4 by default)",
    "-1 — ... enable RapidCommit (2way ip assignment instead of 4way) (off)",
    "-s — ... a list of client macs 00:11:22:33:44:55,00:11:22:33:44:56 (Default: <random>)",
    "-O — ... option-codes to request e.g. 21,22,23 or 12,14-19,23 (Default: 0-80)",
    "-f — ... randomly fuzz packets (off)",
    "-t — ... number of sending threads (1)",
    "-a — ... detect/print arp who_has (off)"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install dhcpig"
    }
  ],
  "usage": "pig.py [-h -v -6 -1 -s -f -t -a -i -o -l -x -y -z -g -r -n -c ] <interface>",
  "subcommands": [],
