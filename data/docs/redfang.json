{
  "id": "redfang",
  "name": "redfang",
  "schema_version": 1,
  "summary": "Finds non-discoverable Bluetooth devices by brute-forcing the last six bytes of the devices' Bluetooth addresses and calling read_remote_name().",
  "highlights": [
    "-r — range i.e. 00803789EE76-00803789EEff",
    "-o — filename Output Scan to Text Logfile An address can also be manf+nnnnnn, where manf is lis",
    "-t — timeout The connect timeout, this is 10000 by default Which is quick and yields results, i",
    "-n — num The number of dongles",
    "-d — Show debug information",
    "-s — Perform Bluetooth Discovery",
    "-l — Show device manufacturer codes"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install redfang"
    }
  ],
