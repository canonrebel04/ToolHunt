{
  "id": "myrescue",
  "name": "myrescue",
  "schema_version": 1,
  "summary": "A hard disk recovery tool that reads undamaged regions first.",
  "highlights": [
    "-b — block size in bytes, default: 4096",
    "-B — bitmap-file, default: <output-file>.bitmap",
    "-A — abort on error",
    "-S — skip errors (exponential-step)",
    "-f — skip blocks with <number> or more failures",
    "-r — try up to <retry-count> reads per block, default: 1",
    "-s — start block number, default: 0",
    "-e — end block number (excl.), default: size of <input-file>"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install myrescue"
    }
  ],
  "usage": "",
  "subcommands": [],
