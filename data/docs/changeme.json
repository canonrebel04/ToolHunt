{
  "id": "changeme",
  "name": "changeme",
  "schema_version": 1,
  "summary": "A default credential scanner.",
  "highlights": [
    "-a — Scan for all protocols",
    "-c — Category of default creds to scan for",
    "--contributors — Display cred file contributors",
    "-d — Debug output",
    "-dl — Specify a delay in milliseconds to avoid 429 status codes default=500",
    "--dump — Print all of the loaded credentials",
    "--dryrun — Print urls to be scan, but don't scan them",
    "-f — Fingerprint targets, but don't check creds"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install changeme"
    }
  ],
  "usage": "changeme.py [-h] [--all] [--category CATEGORY] [--contributors]",
