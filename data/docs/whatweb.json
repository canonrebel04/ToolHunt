{
  "id": "whatweb",
  "name": "whatweb",
  "schema_version": 1,
  "summary": "Next generation web scanner that identifies what websites are running.",
  "highlights": [
    "-i — Read targets from a file. You can pipe hostnames or URLs directly with -i /dev/stdin.",
    "--url-prefix — Add a prefix to target URLs.",
    "--url-suffix — Add a suffix to target URLs.",
    "--url-pattern — Insert the targets into a URL. e.g. example.com/%insert%/robots.txt",
    "-a — Set the aggression level. Default: 1.",
    "-U — Identify as AGENT instead of WhatWeb/0.6.4.",
    "-H — Add an HTTP header. eg \"Foo:Bar\". Specifying a default header will replace it. Specifying ",
    "--follow-redirect — Control when to follow redirects. WHEN may be `never', `http-only', `meta-only', `same-sit"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install whatweb"
    }
  ],
  "usage": "whatweb [options] <URLs>",
  "subcommands": [],
