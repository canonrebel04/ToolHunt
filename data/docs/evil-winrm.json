{
  "id": "evil-winrm",
  "name": "evil-winrm",
  "schema_version": 1,
  "summary": "The ultimate WinRM shell for hacking/pentesting.",
  "highlights": [
    "-S — Enable ssl",
    "-c — Local path to public key certificate",
    "-k — Local path to private key certificate",
    "-r — Kerberos auth, it has to be set also in /etc/krb5.conf file using this format -> CONTOSO.C",
    "-s — Powershell scripts local path",
    "--spn — SPN prefix for Kerberos auth (default HTTP)",
    "-K — Path to Kerberos ticket file (ccache or kirbi format, auto-detected)",
    "-e — C# executables local path"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install evil-winrm"
    }
  ],
  "usage": "evil-winrm -i IP -u USER [-s SCRIPTS_PATH] [-e EXES_PATH] [-P PORT] [-a USERAGENT] [-p PASS] [-H HASH] [-U URL] [-S] [-c PUBLIC_KEY_PATH ] [-k PRIVATE_KEY_PATH ] [-r REALM] [-K TICKET_FILE] [--spn SPN_PREFIX] [-l]",
  "subcommands": [],
