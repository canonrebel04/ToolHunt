{
  "id": "rebind",
  "name": "rebind",
  "schema_version": 1,
  "summary": "DNS Rebinding Tool",
  "highlights": [
    "-i — Specify the network interface to bind to",
    "-d — Specify your registered domain name",
    "-u — Specify the Basic Authentication user name [admin]",
    "-a — Specify the Basic Authentication password [admin]",
    "-r — Specify the initial URL request path [/]",
    "-t — Specify a comma separated list of target IP addresses [client IP]",
    "-n — Specify the callback interval in milliseconds [2000]",
    "-p — Specify the target port [80]"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install rebind"
    }
  ],
  "usage": "dns-rebind [OPTIONS]",
  "subcommands": [],
