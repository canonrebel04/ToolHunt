{
  "id": "pwnat",
  "name": "pwnat",
  "schema_version": 1,
  "summary": "A tool that allows any number of clients behind NATs to communicate with a server behind a separate NAT with *no* port forwarding and *no* DMZ setup on any routers in order to directly communicate with each other.",
  "highlights": [
    "-c — client mode (default) <args>: [local ip] <local port> <proxy host> [proxy port (def:2222)]",
    "-s — server mode <args>: [local ip] [proxy port (def:2222)] [[allowed host]:[allowed port] ...]",
    "-6 — use IPv6",
    "-a — reuse address",
    "-p — reuse port"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install pwnat"
    }
  ],
  "usage": "pwnat <-s | -c> <args>",
  "subcommands": [],
