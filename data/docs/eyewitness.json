{
  "id": "eyewitness",
  "name": "eyewitness",
  "schema_version": 1,
  "summary": "Designed to take screenshots of websites, provide some server header info, and identify default credentials if possible.",
  "highlights": [
    "--web — HTTP Screenshot using Selenium",
    "--no-dns — Skip DNS resolution when connecting to websites",
    "--no-prompt — Don't prompt to open the report",
    "--show-selenium — Show display for selenium",
    "--resolve — Resolve IP/Hostname for targets",
    "--add-http-ports — Comma-separated additional port(s) to assume are http (e.g. '8018,8028')",
    "--add-https-ports — Comma-separated additional port(s) to assume are https (e.g. '8018,8028')",
    "--only-ports — Comma-separated list of exclusive ports to use (e.g. '80,8080')"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install eyewitness"
    }
  ],
  "usage": "EyeWitness.py [--web] [-f Filename] [-x Filename.xml]",
