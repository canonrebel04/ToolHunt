{
  "id": "rifiuti2",
  "name": "rifiuti2",
  "schema_version": 1,
  "summary": "A rewrite of rifiuti, a great tool from Foundstone folks for analyzing Windows Recycle Bin INFO2 file.",
  "highlights": [
    "--help-all — Show all help options",
    "--help-format — Show output formatting options",
    "-o — Write output to FILE",
    "-z — Present deletion time in time zone of local system (default is UTC)",
    "-l — Show legacy (8.3) path if available and specify its CODEPAGE"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install rifiuti2"
    }
  ],
  "usage": "rifiuti2 [OPTION…] INFO2",
