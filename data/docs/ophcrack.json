{
  "id": "ophcrack",
  "name": "ophcrack",
  "schema_version": 1,
  "summary": "Windows password cracker based on rainbow tables.",
  "highlights": [
    "-a — disable audit mode (default)",
    "-A — enable audit mode",
    "-b — disable bruteforce",
    "-B — enable bruteforce (default)",
    "-D — display (lots of!) debugging information",
    "-d — specify tables base directory",
    "-e — do not display empty passwords",
    "-f — load hashes from the specified file (pwdump or session)"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install ophcrack"
    },
    {
      "method": "apt",
      "cmd": "sudo apt install ophcrack-cli"
    }
  ],
  "usage": "ophcrack [OPTIONS]",
