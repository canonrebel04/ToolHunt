{
  "id": "smtp-user-enum",
  "name": "smtp-user-enum",
  "schema_version": 1,
  "summary": "Username guessing tool primarily for use against the default Solaris SMTP service. Can use either EXPN, VRFY or RCPT TO.",
  "highlights": [
    "-m — Maximum number of processes (default: 5)",
    "-U — File of usernames to check via smtp service",
    "-t — Server host running smtp service",
    "-T — File of hostnames running the smtp service",
    "-p — TCP port on which smtp service runs (default: 25)",
    "-d — Debugging output",
    "-w — Wait a maximum of n seconds for reply (default: 5)"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install smtp-user-enum"
    }
  ],
  "usage": "smtp-user-enum [options] ( -u username | -U file-of-usernames ) ( -t host | -T file-of-targets )",
  "subcommands": [],
