{
  "id": "braa",
  "name": "braa",
  "schema_version": 1,
  "summary": "A mass snmp scanner",
  "highlights": [
    "-2 — Claim to be a SNMP2C agent.",
    "-b — Use GETBULK requests for walks.",
    "-x — Hexdump octet-strings",
    "-t — Wait <s> seconds for responses.",
    "-d — Wait <s> microseconds after sending each packet.",
    "-w — Wait <s> microseconds after sending a group of query packets.",
    "-p — Wait <s> milliseconds between subsequent passes.",
    "-r — Retry count (default: 3)."
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install braa"
    }
  ],
  "usage": "braa [options] [query1] [query2] ...",
  "subcommands": [],
