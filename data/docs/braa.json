  "examples": [
    {
      "cmd": "braa public@<ip_address>:<.1.3.6.*>",
      "explanation": "Walk the SNMP tree of host with public string querying all OIDs under `.1.3.6`",
      "source": "tldr:braa"
    },
    {
      "cmd": "braa public@<ip_range>:<.1.3.6.1.2.1.1.6.0>",
      "explanation": "Query the whole subnet `ip_range` for `system.sysLocation.0`",
      "source": "tldr:braa"
    },
    {
      "cmd": "braa private@<ip_address>:<.1.3.6.1.2.1.1.6.0>=s'<workgroup>'",
