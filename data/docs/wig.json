{
  "id": "wig",
  "name": "wig",
  "schema_version": 1,
  "summary": "WebApp Information Gatherer.",
  "highlights": [
    "-l — File with urls, one per line.",
    "-q — Set wig to not prompt for user input during run",
    "-n — Stop after this amount of CMSs have been detected. Default: 1",
    "-a — Do not stop after the first CMS is detected",
    "-m — Try harder to find a match without making more requests",
    "-u — User-agent to use in the requests",
    "-d — Disable the search for subdomains",
    "-t — Number of threads to use"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install wig"
    }
  ],
  "usage": "wig [-h] [-l INPUT_FILE] [-q] [-n STOP_AFTER] [-a] [-m] [-u] [-d]",
  "subcommands": [],
