{
  "id": "dex2jar",
  "name": "dex2jar",
  "schema_version": 1,
  "summary": "A tool for converting Android's .dex format to Java's .class format",
  "highlights": [
    "-f — force overwrite",
    "-o — output .apk file, default is $current_dir/[apk-nam e]-signed.apk",
    "-t — use tiny sign"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install dex2jar"
    }
  ],
  "usage": "d2j-apk-sign [options] <apk>",
  "subcommands": [],
  "flags": [
    {
