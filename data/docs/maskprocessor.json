{
  "id": "maskprocessor",
  "name": "maskprocessor",
  "schema_version": 1,
  "summary": "A High-Performance word generator with a per-position configurable charset.",
  "highlights": [
    "--combinations — Calculate number of combinations",
    "--hex-charset — Assume charset is given in hex",
    "-q — Maximum number of multiple sequential characters",
    "-r — Maximum number of occurrence of a character",
    "-s — Start at specific position",
    "-l — Stop at specific position",
    "-o — Output-file",
    "-1 — User-defineable charsets"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install maskprocessor"
    }
  ],
  "usage": "mp32 [options]... mask",
