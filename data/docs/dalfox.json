{
  "id": "dalfox",
  "name": "dalfox",
  "schema_version": 1,
  "summary": "Parameter Analysis and XSS Scanning tool.",
  "highlights": [
    "--config — Path to a config file (TOML or JSON). Overrides default search path",
    "--debug — Enable debug logging (show DBG lines)",
    "--no-color — Disable colored output (also respects NO_COLOR env var)",
    "-S — Silence all logs except POC output to STDOUT"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install dalfox"
    }
  ],
  "usage": "dalfox [COMMAND] [TARGET] <FLAGS>",
  "subcommands": [
    {
      "name": "scan",
      "description": "Scan targets for XSS"
    },
    {
      "name": "server",
      "description": "Run API/server mode"
    },
    {
      "name": "payload",
      "description": "Manage or enumerate payloads"
    },
    {
      "name": "mcp",
      "description": "Run MCP stdio server (Model Context Protocol) exposing Dalfox tools"
    },
    {
      "name": "completion",
      "description": "Generate shell completion scripts"
    },
    {
      "name": "help",
      "description": "Print this message or the help of the given subcommand(s)"
    }
  ],
  "flags": [
