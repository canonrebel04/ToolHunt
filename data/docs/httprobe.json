{
  "id": "httprobe",
  "name": "httprobe",
  "schema_version": 1,
  "summary": "Take a list of domains and probe for working HTTP and HTTPS servers",
  "highlights": [
    "-c — set the concurrency level (split equally between HTTPS and HTTP requests) (default 20)",
    "-method — HTTP method to use (default \"GET\")",
    "-p — add additional probe (proto:port)",
    "-prefer-https — only try plain HTTP if HTTPS fails",
    "-s — skip the default probes (http:80 and https:443)",
    "-t — timeout (milliseconds) (default 10000)"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install httprobe"
    }
  ],
  "usage": "of httprobe:",
  "subcommands": [],
  "flags": [
    {
      "name": "-c",
      "short": "",
      "aliases": [],
      "arg": "int",
      "required": false,
      "description": "set the concurrency level (split equally between HTTPS and HTTP requests) (default 20)",
      "default": "20",
      "example": "httprobe -c <int>"
    },
    {
      "name": "-method",
      "short": "",
      "aliases": [],
      "arg": "string",
      "required": false,
      "description": "HTTP method to use (default \"GET\")",
      "default": "GET",
      "example": "httprobe -method <string>"
    },
    {
      "name": "-p",
      "short": "",
