{
  "id": "netexec",
  "name": "netexec",
  "schema_version": 1,
  "summary": "A Windows / Active Directory environments pentest tool.",
  "highlights": [
    "-t — set how many concurrent threads to use",
    "--timeout — max timeout in seconds of each thread",
    "--jitter — sets a random delay between each authentication",
    "--no-progress — do not displaying progress bar during scan",
    "--log — export result into a custom file",
    "--verbose — enable verbose output",
    "--debug — enable debug level information",
    "-6 — Enable force IPv6"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install netexec"
    }
  ],
  "usage": "netexec [-h] [--version] [-t THREADS] [--timeout TIMEOUT]",
