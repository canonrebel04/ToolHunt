    "-b — Beginning of the password. default: \"\"",
    "-e — End of the password. default: \"\"",
    "-f — Read the passwords from a file instead of generating them.",
    "-l — Minimum password length (beginning and end included). default: 1",
    "-m — Maximum password length (beginning and end included). default: 8",
    "-s — Password character set. default: \"0123456789ABCDEFGHIJKLMNOPQRSTU VWXYZabcdefghijklmnopqrs",
    "-t — Number of threads to use. default: 1",
    "-w — Restore the state of a previous session if the file exists, then write the state to the fi"
  ],
