{
  "id": "cewl",
  "name": "cewl",
  "schema_version": 1,
  "summary": "A custom word list generator.",
  "highlights": [
    "-k — Keep the downloaded file.",
    "-d — Depth to spider to, default 2.",
    "-m — Minimum word length, default 3.",
    "-x — Maximum word length, default unset.",
    "-o — Let the spider visit other sites.",
    "--exclude — A file containing a list of paths to exclude",
    "--allowed — A regex pattern that path must match to be followed",
    "-w — Write the output to the file."
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install cewl"
    }
  ],
  "usage": "cewl [OPTIONS] ... <url>",
