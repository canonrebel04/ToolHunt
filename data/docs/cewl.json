      "source": "tldr:cewl"
    },
    {
      "cmd": "cewl --with-numbers --min_word_length 5 <url>",
      "explanation": "Output an alphanumeric wordlist from the given URL with words of minimum 5 characters",
      "source": "tldr:cewl"
    },
    {
      "cmd": "cewl --debug --email <url>",
      "explanation": "Output a wordlist from the given URL in debug mode including email addresses",
      "source": "tldr:cewl"
    },
