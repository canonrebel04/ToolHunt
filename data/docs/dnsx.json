  "examples": [
    {
      "cmd": "echo <example.com> | dnsx -a -resp",
      "explanation": "Query the A record of a (sub)domain and show [re]sponse received",
      "source": "tldr:dnsx"
    },
    {
      "cmd": "dnsx <<< <example.com> -recon -resp",
      "explanation": "Query all the DNS records (A, AAAA, CNAME, NS, TXT, SRV, PTR, MX, SOA, AXFR, CAA)",
      "source": "tldr:dnsx"
    },
    {
      "cmd": "echo <example.com> | dnsx -resp -<a|aaaa|cname|ns|txt|srv|ptr|mx|soa|any|axfr|caa>",
      "explanation": "Query a specific type of DNS record",
      "source": "tldr:dnsx"
    },
    {
      "cmd": "echo <example.com> | dnsx -resp-only",
      "explanation": "Output response only (do not show the queried domain or subdomain)",
      "source": "tldr:dnsx"
    },
    {
      "cmd": "echo <example.com> | dnsx -<debug|raw> -resolver <1.1.1.1,8.8.8.8,...> -retry <number>",
      "explanation": "Display raw response of a query, specifying resolvers to use and retry attempts for failures",
      "source": "tldr:dnsx"
    },
    {
      "cmd": "dnsx -domain <FUZZ.example.com> -wordlist <path/to/wordlist.txt> -resp",
      "explanation": "Brute force DNS records using a placeholder",
      "source": "tldr:dnsx"
    },
    {
      "cmd": "dnsx -domain <path/to/domain.txt> -wordlist <path/to/wordlist.txt> -resp -output <path/to/output.txt> -no-color",
      "explanation": "Brute force DNS records from a list of domains and wordlists, appending output to a file with no color codes",
      "source": "tldr:dnsx"
    },
    {
      "cmd": "subfinder -silent -domain <example.com> | dnsx -cname -resp -rate-limit <number>",
      "explanation": "Extract `CNAME` records for the given list of subdomains, with rate limiting DNS queries per second",
      "source": "tldr:dnsx"
    }
