{
  "id": "dnsx",
  "name": "dnsx",
  "schema_version": 1,
  "summary": "Fast and multi-purpose DNS toolkit allow to run multiple DNS queries of your choice with a list of user-supplied resolvers.",
  "highlights": [
    "-l — list of sub(domains)/hosts to resolve (file or comma separated or stdin)",
    "-d — list of domain to bruteforce (file or comma separated or stdin)",
    "-w — list of words to bruteforce (file or comma separated or stdin)",
    "-a — query A record (default)",
    "-aaaa — query AAAA record",
    "-cname — query CNAME record",
    "-ns — query NS record",
    "-txt — query TXT record"
  ],
  "install": [
    {
      "method": "apt",
      "cmd": "sudo apt install dnsx"
    }
  ],
  "usage": "dnsx [flags]",
